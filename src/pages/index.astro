---
import BaseLayout from '../layouts/BaseLayout.astro';
import WatchCard from '../components/WatchCard.astro';
import SearchBar from '../components/SearchBar.astro';
import { getCollection } from 'astro:content';

const pairs = await getCollection('pairs');
---

<BaseLayout
  title="Homage Index — Luxury Watch Homages, Ranked"
  description="Find the most visually accurate homage for every luxury watch. Side-by-side comparisons, similarity scores, and direct links to buy."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="t-label hero-eyebrow">The definitive resource</p>
      <h1 class="hero-title">Luxury watches.<br/>Accessible prices.</h1>
      <p class="hero-sub">
        Every pair ranked by visual similarity. Every homage linked directly to buy.
      </p>
    </div>
  </section>

  <!-- Filter bar -->
  <section class="filter-bar">
    <div class="container filter-inner">
      <div class="filter-drawer" id="filter-drawer">
        <div class="filter-scroll">
          <span class="t-label filter-label">Browse by</span>
          <div class="filter-chips" role="list">
            <span class="filter-chip filter-chip--active t-label" role="listitem">All</span>
            <span class="filter-chip t-label" role="listitem">Dive</span>
            <span class="filter-chip t-label" role="listitem">Dress Sports</span>
            <span class="filter-chip t-label" role="listitem">Pilot</span>
            <span class="filter-chip t-label" role="listitem">Dress</span>
          </div>
        </div>
      </div>

      <div class="filter-actions">
        <button 
          type="button" 
          class="filter-toggle-btn t-label" 
          id="filter-toggle"
          aria-expanded="false" 
          aria-controls="filter-drawer"
          aria-label="Toggle category filters"
        >
          <svg class="filter-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="21" x2="4" y2="14"></line>
            <line x1="4" y1="10" x2="4" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12" y2="3"></line>
            <line x1="20" y1="21" x2="20" y2="16"></line>
            <line x1="20" y1="12" x2="20" y2="3"></line>
            <line x1="1" y1="14" x2="7" y2="14"></line>
            <line x1="9" y1="8" x2="15" y2="8"></line>
            <line x1="17" y1="16" x2="23" y2="16"></line>
          </svg>
          <span class="filter-btn-text">Filter</span>
          <span class="filter-badge" id="filter-badge" aria-hidden="true"></span>
        </button>
        <SearchBar />
      </div>
    </div>
  </section>

  <!-- Pair directory -->
  <section class="directory">
    <div class="container">
      {pairs.map((pair) => (
        <article class="luxury-group" data-category={pair.data.category} aria-label={`Homages for ${pair.data.luxury.brand} ${pair.data.luxury.model}`}>
          <!-- Luxury watch heading exactly as user requested -->
          <h2 class="luxury-title">
            {pair.data.luxury.brand} {pair.data.luxury.model} {pair.data.luxury.reference} {pair.data.luxury.imageAlt.toLowerCase().includes('black') ? 'black dial' : 'blue dial'}
          </h2>
          
          <!-- Grid of homages: 3 columns on desktop to make them bigger and reveal all gorgeous details -->
          <div class="shrunk-grid">
            {pair.data.homages.map((homage) => (
              <WatchCard watch={homage} variant="homage" simplified={true} comparisonUrl={`/${pair.data.seo.slug}`} />
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  // Mobile filter drawer toggle
  const filterToggle = document.getElementById('filter-toggle');
  const filterDrawer = document.getElementById('filter-drawer');
  const filterBadge = document.getElementById('filter-badge');

  if (filterToggle && filterDrawer) {
    filterToggle.addEventListener('click', () => {
      const isExpanded = filterToggle.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;
      
      filterToggle.setAttribute('aria-expanded', String(nextState));
      filterToggle.classList.toggle('filter-toggle-btn--open', nextState);
      filterDrawer.classList.toggle('filter-drawer--open', nextState);
    });
  }

  // Filter chips interaction
  const chips = document.querySelectorAll('.filter-chip');
  const groups = document.querySelectorAll('.luxury-group');

  function applyCategoryFilter(chipElement: Element) {
    chips.forEach(c => c.classList.remove('filter-chip--active'));
    chipElement.classList.add('filter-chip--active');

    const textContent = chipElement.textContent;
    if (!textContent) return;
    
    const category = textContent.trim().toLowerCase();

    // Update filter badge indicator on mobile
    if (filterBadge) {
      if (category !== 'all') {
        filterBadge.classList.add('filter-badge--visible');
      } else {
        filterBadge.classList.remove('filter-badge--visible');
      }
    }

    groups.forEach(group => {
      const categoryAttr = group.getAttribute('data-category');
      if (!categoryAttr) return;

      const groupCategory = categoryAttr.trim().toLowerCase();
      
      // Exact matching logic to avoid "Dress" matching "Dress Sports"
      let isMatch = false;
      if (category === 'all') {
        isMatch = true;
      } else if (category === 'dress') {
        isMatch = groupCategory === 'dress' || groupCategory === 'dress watches';
      } else if (category === 'dive') {
        isMatch = groupCategory === 'dive' || groupCategory === 'dive watches';
      } else {
        isMatch = groupCategory === category || groupCategory.startsWith(category);
      }

      if (isMatch) {
        (group as HTMLElement).style.display = 'block';
      } else {
        (group as HTMLElement).style.display = 'none';
      }
    });
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => applyCategoryFilter(chip));
  });
</script>

<style>
/* ── Hero ── */
.hero {
  padding: 1.75rem 0 2rem;
  border-bottom: 1px solid var(--color-border);
}

.hero-eyebrow {
  color: var(--color-ink-faint);
  margin-bottom: 0.75rem;
}

.hero-title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 300;
  font-style: normal;
  font-variant-numeric: lining-nums;
  line-height: 1.1;
  color: var(--color-ink);
  margin-bottom: 1rem;
}

.hero-sub {
  font-size: 0.9rem;
  color: var(--color-ink-muted);
  max-width: 460px;
  line-height: 1.7;
}

/* ── Filter bar ── */
.filter-bar {
  border-bottom: 1px solid var(--color-border);
  padding: 0.5rem 0;
  background: #faf9f6;
  z-index: 90;
  position: sticky;
  top: 49px;
}

@media (min-width: 540px) {
  .filter-bar {
    padding: 0.85rem 0;
  }
}

.filter-inner {
  display: flex;
  flex-direction: column;
  gap: 0;
}

@media (min-width: 540px) {
  .filter-inner {
    flex-direction: row;
    align-items: center;
    gap: 1rem;
  }
}

.filter-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  flex-shrink: 0;
}

@media (max-width: 539px) {
  .filter-actions {
    order: 2;
  }

  .filter-actions :global(.search-wrapper) {
    flex: 1;
    min-width: 0;
  }
}

@media (min-width: 540px) {
  .filter-actions {
    order: 2;
    width: calc((100% - 1.5rem) / 2);
    max-width: none;
    margin-left: auto;
    gap: 0;
  }
}

@media (min-width: 768px) {
  .filter-actions {
    width: calc((100% - 3rem) / 3);
  }
}

/* Mobile Filter Toggle Button (co-exists on the same line as search bar) */
.filter-toggle-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 40px;
  padding: 0 14px;
  border-radius: 999px;
  border: 1px solid var(--color-ink);
  background: var(--color-ink);
  color: #ffffff;
  cursor: pointer;
  white-space: nowrap;
  transition: background-color var(--transition), border-color var(--transition), color var(--transition), opacity var(--transition);
  font-family: var(--font-body);
  font-size: 11px;
  line-height: 1;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  flex-shrink: 0;
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

.filter-btn-text {
  display: inline-flex;
  align-items: center;
  line-height: 1;
}

.filter-toggle-btn:hover {
  opacity: 0.88;
}

.filter-toggle-btn:focus-visible {
  outline: 1.5px solid var(--color-ink);
  outline-offset: 2px;
}

.filter-toggle-btn--open {
  background: transparent;
  color: var(--color-ink);
  border-color: var(--color-border);
  opacity: 1;
}

.filter-toggle-btn--open:hover {
  border-color: var(--color-ink);
  opacity: 1;
}

.filter-toggle-btn--open .filter-icon {
  stroke: var(--color-ink);
}

.filter-icon {
  flex-shrink: 0;
  stroke: #ffffff;
  transition: stroke var(--transition);
}

.filter-badge {
  display: none;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #ffffff;
  margin-left: 2px;
  transition: background-color var(--transition);
}

.filter-badge--visible {
  display: inline-block;
}

.filter-toggle-btn--open .filter-badge {
  background: var(--color-ink);
}

@media (min-width: 540px) {
  .filter-toggle-btn {
    display: none;
  }
}

/* ── Filter Drawer (Mobile Expandable Container) ── */
@media (max-width: 539px) {
  .filter-drawer {
    order: 1;
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    margin-bottom: 0;
    transition: grid-template-rows 0.22s ease, opacity 0.18s ease, margin-bottom 0.22s ease;
    width: 100%;
  }

  .filter-drawer.filter-drawer--open {
    grid-template-rows: 1fr;
    opacity: 1;
    margin-bottom: 0.65rem;
  }

  .filter-drawer > .filter-scroll {
    overflow: hidden;
    min-height: 0;
    width: 100%;
  }

  .filter-drawer.filter-drawer--open > .filter-scroll {
    overflow-x: auto;
  }
}

@media (min-width: 540px) {
  .filter-drawer {
    order: 1;
    flex: 1;
    min-width: 0;
    display: block;
    margin: 0;
  }
}

.filter-scroll {
  display: flex;
  align-items: center;
  gap: 1rem;
  overflow-x: auto;
  scrollbar-width: none;
  width: 100%;
}

.filter-scroll::-webkit-scrollbar { display: none; }

.filter-label { color: var(--color-ink-faint); flex-shrink: 0; }

.filter-chips { display: flex; gap: 0.5rem; flex-shrink: 0; }

.filter-chip {
  padding: 4px 12px;
  border-radius: 20px;
  border: 1px solid var(--color-border);
  color: var(--color-ink-muted);
  cursor: pointer;
  white-space: nowrap;
  transition: all var(--transition);
}

.filter-chip:not(.filter-chip--active):hover {
  border-color: var(--color-border-strong);
  color: var(--color-ink);
}

.filter-chip--active {
  background: var(--color-ink);
  color: #fff;
  border-color: var(--color-ink);
}

/* ── Directory ── */
.directory {
  padding: 3rem 0;
}

.luxury-group {
  margin-bottom: 4.5rem;
}

.luxury-title {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 4.5vw, 2.25rem);
  font-weight: 300;
  font-variant-numeric: lining-nums;
  color: var(--color-ink);
  margin-bottom: 1.5rem;
  border-bottom: 1px solid var(--color-border);
  padding-bottom: 0.5rem;
  letter-spacing: 0.02em;
}

/* Homepage Grid: 3 columns on desktop to make cards bigger and visually legible */
.shrunk-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
  margin-bottom: 1.5rem;
  align-items: stretch;
}

@media (min-width: 540px) {
  .shrunk-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 768px) {
  .shrunk-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

/* ── Homepage WatchCard Styling Overrides ── */
.shrunk-grid :global(.watch-card) {
  border-radius: var(--radius-md);
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
  display: flex;
  flex-direction: column;
  height: 100%;
}

.shrunk-grid :global(.watch-card:hover) {
  transform: translateY(-3px);
  border-color: var(--color-gold);
  box-shadow: 0 4px 15px rgba(200, 184, 154, 0.15);
}

.shrunk-grid :global(.card-image) {
  aspect-ratio: 4 / 3;
  width: 100%;
}

.shrunk-grid :global(.card-image img) {
  padding: 1rem;
}

.shrunk-grid :global(.card-body) {
  flex-grow: 1;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: stretch;
  padding: 0.85rem 1rem 0.65rem;
  gap: 0.5rem;
}

.shrunk-grid :global(.card-identity) {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  flex: 1;
  min-height: 48px; /* standard height to align wrapping watch titles */
}

.shrunk-grid :global(.card-brand) {
  font-size: 11px;
  margin-bottom: 2px;
}

.shrunk-grid :global(.card-model) {
  font-size: 1.2rem;
  line-height: 1.25;
  margin-top: 2px;
}

.shrunk-grid :global(.card-price-block) {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-end;
  text-align: right;
  flex-shrink: 0;
}

.shrunk-grid :global(.card-price) {
  font-size: 1.45rem;
  line-height: 1;
}

.shrunk-grid :global(.card-price-label) {
  font-size: 9px;
  margin-top: 3px;
}

.shrunk-grid :global(.card-cta) {
  padding: 0.4rem 1rem 1rem;
  margin-top: auto;
}

.shrunk-grid :global(.cta-btn) {
  padding: 10px 0.5rem;
  font-size: 11px;
  letter-spacing: 0.12em;
}

.shrunk-grid :global(.card-comparison) {
  margin-top: auto;
}
</style>
